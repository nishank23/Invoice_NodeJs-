PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET_KEY=<generate-a-strong-random-secret>
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=<gmail-app-password>

# Public base URL used in verification/reset emails and rendered previews.
# If unset, the incoming request host is used.
BASE_URL=http://localhost:3000

# Comma-separated list of allowed browser origins. Leave unset for "*" (mobile API).
CORS_ORIGIN=
